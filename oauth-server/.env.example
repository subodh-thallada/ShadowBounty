# Server configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Blockchain configuration (Monad Testnet)
RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=your_private_key_without_0x_prefix
CONTRACT_ADDRESS=your_deployed_contract_address

# Optional: GitHub token for server-side API calls (higher rate limit for project analysis)
# DEV_GITHUB_TOKEN=ghp_xxx
# GITHUB_TOKEN=ghp_xxx

# Optional: Curated list of developers for project recommendations (comma-separated)
# Use GitHub usernames or full profile URLs (e.g. https://github.com/torvalds)
# CURATED_DEVELOPER_USERNAMES=user1,user2,https://github.com/torvalds